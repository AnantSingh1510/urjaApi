# Demo is deterministic, synthetic, and needs no portal credentials.
URJA_DEMO=true
URJA_BASE_URL=https://urja-ops.flockenergy.tech
# For live mode, set URJA_DEMO=false and supply credentials from the assignment.
URJA_USERNAME=
URJA_PASSWORD=
# Optional API key for /v1 routes. Recommended if accessible beyond localhost.
URJA_API_KEY=
URJA_CATALOG_TTL_SECONDS=300
URJA_READINGS_TTL_SECONDS=60
URJA_PORTAL_TIMEZONE=Asia/Kolkata
URJA_TIMEOUT_SECONDS=15
URJA_OPERATION_TIMEOUT_SECONDS=60
