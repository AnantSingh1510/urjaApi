    "/v1/meters": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "Meters",
        "description": "Search the complete export. q matches ID/serial; other text filters are case-insensitive\nexact matches. Geographic search requires all three parameters and uses great-circle\ndistance. Sort: distance then ID for geo search, otherwise ID. Offset is zero-based.",
