    "/v1/meters/{meter_id}/readings": {
      "get": {
        "tags": [
          "Readings"
        ],
        "summary": "Readings",
        "description": "Read the portal's default window. start/end filter that window locally; they do not\nfetch older history. Register values are cumulative. Interval deltas require unique,\nconsecutive 30-minute timestamps and nondecreasing valid kWh. Summary covers the full\nfiltered window before pagination. The first filtered reading has no interval delta.",
        "operationId": "readings_v1_meters__meter_id__readings_get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Meter Id"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Inclusive ISO 8601 timestamp with offset.",
              "title": "Start"
            },
            "description": "Inclusive ISO 8601 timestamp with offset."
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Inclusive ISO 8601 timestamp with offset.",
              "title": "End"
            },
            "description": "Inclusive ISO 8601 timestamp with offset."
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 2000,
              "minimum": 1,
              "default": 500,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
