          },
          {
            "name": "transformer_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "title": "Transformer Code"
            }
          },
          {
            "name": "latitude",
