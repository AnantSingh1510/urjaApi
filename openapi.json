  "components": {
    "schemas": {
      "Envelope_Meter_": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Meter"
          },
          "freshness": {
            "$ref": "#/components/schemas/Freshness"
          }
        },
        "type": "object",
        "required": [
          "data",
          "freshness"
        ],
        "title": "Envelope[Meter]"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "Freshness": {
        "properties": {
          "fetched_at": {
            "type": "string",
            "format": "date-time",
            "title": "Fetched At"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "source": {
            "type": "string",
            "enum": [
              "portal",
              "synthetic_demo"
            ],
            "title": "Source"
          }
        },
        "type": "object",
        "required": [
          "fetched_at",
          "expires_at",
          "source"
        ],
        "title": "Freshness"
      },
      "Geo": {
        "properties": {
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude"
          }
        },
        "type": "object",
        "required": [
          "latitude",
          "longitude"
        ],
        "title": "Geo"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "Health"
      },
      "HierarchyEntry": {
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "zone",
              "circle",
              "division",
              "subdivision",
              "substation",
              "feeder",
              "dt"
            ],
            "title": "Level"
          },
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
